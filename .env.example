# API Keys (get your own at https://serper.dev, https://console.mistral.ai, https://aistudio.google.com)
SERPER_API_KEY="your-serper-api-key"
MISTRAL_API_KEY="your-mistral-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# PostgreSQL connection string
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/refseeker"

# JWT secret (change to a random string in production, min 32 chars)
JWT_SECRET="change-me-in-production"

# ── Docker ──────────────────────────────────────────────────────────────
# docker compose reads .env automatically — just set the vars above
# and run:  docker compose up --build
# DATABASE_URL and JWT_SECRET in docker-compose.yml use the values above.
# SERPER_API_KEY, MISTRAL_API_KEY, GEMINI_API_KEY are passed through.
